{
  "rewrites": [
    {
      "source": "/events/:id",
      "has": [
        {
          "type": "header",
          "key": "User-Agent",
          "value": ".*(facebookexternalhit|WhatsApp|whatsapp|twitterbot|Twitterbot|telegrambot|TelegramBot|discordbot|Discordbot|slackbot|Slackbot|linkedinbot|LinkedInBot|googlebot|Googlebot|bingbot|Bingbot|baiduspider|yandexbot|embedly).*"
        }
      ],
      "destination": "https://mediumblue-llama-100354.hostingersite.com/api/events/:id/og"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
